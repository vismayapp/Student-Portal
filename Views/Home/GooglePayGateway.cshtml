@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Processing Payment...</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        .spinner-growth {
            width: 3rem;
            height: 3rem;
            color: #4f46e5;
        }
    </style>
</head>
<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">
    <div class="text-center">
        <div class="spinner-grow mb-3" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <h4 class="fw-bold text-dark">Contacting Google Pay Secure Servers</h4>
        <p class="text-muted small">Please do not refresh or close this application window...</p>
    </div>

    <script>
        // Simulates 2.5 seconds of payment verification latency, then updates cleanly to success page
        setTimeout(() => {
            const urlParams = new URLSearchParams(window.location.search);
            const amount = urlParams.get('amount');
            const item = urlParams.get('item');
            const institution = urlParams.get('institution');
            
            window.location.href = `/Course/PaymentSuccess?amount=${amount}&item=${encodeURIComponent(item)}&institution=${encodeURIComponent(institution)}`;
        }, 2500);
    </script>
</body>
</html>
