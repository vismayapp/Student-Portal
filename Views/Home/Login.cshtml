@model Login.Models.LoginViewModel

@{
    ViewData["Title"] = "Sign In";
}

<style>
    :root {
        --primary-glow: #4f46e5;      /* Modern Indigo */
        --secondary-glow: #06b6d4;    /* Electric Cyan */
        --card-bg: rgba(255, 255, 255, 0.45);
        --card-border: rgba(255, 255, 255, 0.6);
        --input-bg: rgba(255, 255, 255, 0.6);
        --input-border: rgba(0, 0, 0, 0.08);
        --text-main: #1e293b;         /* Slate 800 */
        --text-muted: #64748b;        /* Slate 500 */
    }

   body {
        /* Layered light tint overlay blended directly with your image file path */
        background: linear-gradient(
                        135deg, 
                        rgba(15, 23, 42, 0.5) 0%, 
                rgba(30, 41, 59, 0.4)
                    ), 
                    url('/images/log.jpg'); /* <-- Maps directly to your local file path */
        
        /* Forces the graphic asset to fix background viewport positioning while scaling gracefully */
        background-attachment: fixed;
        background-position: center center;
        background-repeat: no-repeat;
        background-size: cover;
        
        min-height: 100vh;
        overflow-x: hidden;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }


    

    /* Floating background glowing orbs - tweaked for light mode opacity */
    .bg-glow-1, .bg-glow-2 {
        position: absolute;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.25;
        z-index: 0;
        pointer-events: none;
    }
    .bg-glow-1 { top: 10%; left: 15%; background: var(--primary-glow); }
    .bg-glow-2 { bottom: 10%; right: 15%; background: var(--secondary-glow); }

    /* Ultra-premium light glass container */
    .glass-card-wrapper {
        position: relative;
        z-index: 1;
        max-width: 440px;
        width: 100%;
        margin: auto;
    }

    .glass-card {
        background: var(--card-bg) !important;
        backdrop-filter: blur(20px) saturate(160%);
        -webkit-backdrop-filter: blur(20px) saturate(160%);
        border: 1px solid var(--card-border) !important;
        border-radius: 24px !important;
        /* Softer, more realistic shadow for light interfaces */
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.02) !important;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    }

    .glass-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 30px 60px rgba(15, 23, 42, 0.12), 0 0 30px rgba(79, 70, 229, 0.05) !important;
    }

    /* Glass form floating inputs */
    .glass-input-group .form-control {
        background-color: var(--input-bg) !important;
        border: 1px solid var(--input-border) !important;
        color: var(--text-main) !important;
        border-radius: 14px !important;
        font-weight: 500;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .glass-input-group .form-control:focus {
        background-color: #ffffff !important;
        border-color: var(--primary-glow) !important;
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.12) !important;
    }

    .glass-input-group label {
        color: var(--text-muted) !important;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    /* Floating label overrides for Bootstrap compatibility */
    .glass-input-group .form-control:focus ~ label,
    .glass-input-group .form-control:not(:placeholder-shown) ~ label {
        color: var(--primary-glow) !important;
        font-weight: 600;
        transform: scale(0.85) translateY(-0.6rem) translateX(0.15rem);
    }

    /* Premium interactive vibrant button */
    .btn-gradient {
        background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
        border: none !important;
        border-radius: 14px !important;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
    }

    .btn-gradient:hover {
        background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.35) !important;
    }

    .btn-gradient:active {
        transform: translateY(1px);
    }
    
    /* Clean custom helper text style */
    .text-slate-muted {
        color: var(--text-muted);
    }
</style>

<div class="bg-glow-1"></div>
<div class="bg-glow-2"></div>

<div class="container d-flex align-items-center justify-content-center" style="min-height: 90vh;">
    <div class="glass-card-wrapper">
        <div class="card glass-card p-4 p-sm-5">
            
            <div class="text-center mb-4">
                

                <h2 class="fw-bold mb-2" style="color: var(--text-main); letter-spacing: -0.5px;">Welcome Back</h2>
                <p class="text-slate-muted small">Please enter your details to sign in</p>
            </div>

            <form asp-controller="Home" asp-action="Login" method="post" autocomplete="off">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-floating mb-3 glass-input-group">
                    <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" required />
                    <label asp-for="Email">Email Address</label>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-floating mb-4 glass-input-group">
                    <input asp-for="Password" class="form-control" type="password" placeholder="Password" required />
                    <label asp-for="Password">Password</label>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                <a asp-action="ForgotPassword" asp-controller="Home">Forgot Password?</a>

                <button type="submit" class="btn btn-gradient w-100 py-3 text-white fw-bold">
                    Sign In
                </button>
            </form>
            
        </div>
    </div>
</div>