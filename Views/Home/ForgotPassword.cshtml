@model Login.Models.RegisterViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    html, body {
        overflow-x: hidden !important;
        background-color: #0b0f19 !important; /* Blends cleanly with the main layout */
    }

    /* Fluid wrapper structure that maps the background image with a dark layout transparency layer */
    .auth-bg-wrapper {
        background: linear-gradient(rgba(11, 15, 25, 0.75), rgba(11, 15, 25, 0.82)), 
                    url('https://images.unsplash.com/photo-1427504494785-3a9ca7044f45?q=80&w=1920') no-repeat center center;
        background-size: cover;
        background-attachment: fixed;
        width: 100%;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }
    
    /* Elegant Clean Light Card Container */
    .auth-card-custom {
        border: none !important;
        border-radius: 16px !important;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3) !important;
        background-color: #ffffff !important;
        width: 100%;
        max-width: 460px;
        padding: 3rem 2.5rem !important;
        transition: transform 0.3s ease;
    }

    /* Form Fields for Light Theme Card */
    .form-control-custom {
        border-radius: 10px !important;
        padding: 0.75rem 1rem !important;
        border: 1px solid #cbd5e1 !important;
        background-color: #ffffff !important;
        color: #0f172a !important;
        transition: all 0.2s ease-in-out;
    }
    
    .form-control-custom:focus {
        border-color: #4f46e5 !important;
        box-shadow: 0 0 0 0.25rem rgba(79, 70, 229, 0.15) !important;
        background-color: #ffffff !important;
    }

    .form-control-custom::placeholder {
        color: #94a3b8 !important;
    }

    /* Premium Indigo Action Controls */
    .btn-indigo-custom {
        background-color: #4f46e5 !important;
        border-color: #4f46e5 !important;
        color: #ffffff !important;
        border-radius: 10px !important;
        padding: 0.75rem 1.5rem !important;
        font-weight: 600 !important;
        transition: all 0.2s ease-in-out !important;
    }
    
    .btn-indigo-custom:hover {
        background-color: #3730a3 !important;
        border-color: #3730a3 !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2) !important;
    }

    .btn-indigo-custom:active {
        transform: translateY(0);
    }

    /* Interactive Soft Link Styles */
    .back-link {
        color: #64748b;
        font-weight: 500;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: #4f46e5;
    }
</style>

<div class="auth-bg-wrapper">
    <div class="auth-card-custom animate-fade-in">
        
        @if (ViewBag.Message != null)
        {
            <div class="text-center">
                <!-- Decorative Icon Header -->
                <div class="d-inline-flex align-items-center justify-content-center bg-indigo bg-opacity-10 text-primary rounded-circle mb-4" style="width: 80px; height: 80px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="#4f46e5" class="bi bi-envelope-check-fill" viewBox="0 0 16 16">
                        <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm5.436-1.879L16 10.501V4.697z"/>
                        <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-1.993-1.679a.5.5 0 0 0-.696.074l-1.92 2.417-.754-.754a.5.5 0 0 0-.707.708l1.001 1.001a.5.5 0 0 0 .753-.057l2.25-2.833a.5.5 0 0 0-.073-.696"/>
                    </svg>
                </div>

                <h4 class="fw-bold text-dark mb-2">Reset Link Generated!</h4>
                <p class="small text-muted mb-4 px-2">An email system isn't configured yet, but you can safely use the secure staging token below to proceed:</p>
                
                <a href="@ViewBag.ResetLink" class="btn btn-indigo-custom w-100 py-3 mb-4 shadow-sm">
                    Click Here to Reset Password
                </a>
                
                <div class="text-center">
                    <a asp-action="Index" class="back-link small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Home
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="text-center mb-4">
                <!-- Decorative Graphic Shield Lock Icon -->
                <div class="d-inline-flex align-items-center justify-content-center bg-secondary bg-opacity-10 rounded-circle mb-3" style="width: 64px; height: 64px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#475569" class="bi bi-shield-lock" viewBox="0 0 16 16">
                        <path d="M5.338 1.59a61 61 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.829.502l.142.065c.036.015.066.027.09.034a.2.2 0 0 0 .142 0c.024-.007.054-.019.09-.034l.142-.065c.177-.082.483-.258.829-.502a10.7 10.7 0 0 0 2.287-2.233c1.527-1.998 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7.2 7.2 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.3 7.3 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                        <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415v1.085a.5.5 0 0 1-1 0V7.915A1.5 1.5 0 1 1 9.5 6.5"/>
                    </svg>
                </div>
                
                <h3 class="fw-bold text-dark mb-1">Forgot Password?</h3>
                <p class="text-muted small px-3">Enter your email address below and we will help you reset your account credentials.</p>
            </div>

            <form method="post" asp-action="ForgotPassword">
                <div class="mb-4">
                    <label class="form-label fw-semibold text-secondary small mb-1">Email Address</label>
                    <input type="email" name="email" class="form-control form-control-custom" placeholder="name@example.com" required />
                </div>

                <button type="submit" class="w-100 btn btn-indigo-custom py-2.5 mb-4 shadow-sm">Send Reset Link</button>
                
                <div class="text-center">
                    <a asp-action="Index" class="back-link small">
                        <i class="bi bi-arrow-left me-1"></i> Back to Home
                    </a>
                </div>
            </form>
        }

    </div>
</div>